{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "secretaria-estaca",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Solo /api/* ejecuta el Worker (y gasta solicitudes del plan). Lo demás se sirve como archivos estáticos.
    "run_worker_first": ["/api/*"],
    // La app es de una sola página: cualquier ruta devuelve index.html.
    "not_found_handling": "single-page-application",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "secretaria-estaca",
      // Se rellena tras `wrangler d1 create secretaria-estaca` (ver README, sección Fase 4).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "observability": { "enabled": false },
}
